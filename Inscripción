<script>
  // Reemplazar por la URL de la aplicación web de Google Apps Script (termina en /exec).
  const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwG_PTs21-LbOYnsodxoHxzBZY0j8H45s92dGTR_c3hYg32cSqV4To1Q4bfTqfWIXyW/exec";

  document.querySelectorAll('[data-ir]').forEach(function (elemento) {
    elemento.addEventListener('click', function () {
      const destino = elemento.getAttribute('data-ir');
      document.querySelectorAll('.pantalla').forEach(function (pantalla) {
        pantalla.classList.remove('activa');
      });
      document.getElementById(destino).classList.add('activa');
      window.scrollTo(0, 0);
    });
  });

  const formulario = document.getElementById('formInscripcion');
  const boton = document.getElementById('botonEnviar');
  const mensaje = document.getElementById('mensajeEstado');
  const contenedorForm = document.getElementById('tarjeta-form-contenedor');
  const contenedorPago = document.getElementById('tarjeta-pago-contenedor');
  const botonWhatsapp = document.getElementById('botonWhatsapp');
  let ultimoEmail = '';

  function irAPantallaPago() {
    formulario.reset();
    contenedorForm.style.display = 'none';
    contenedorPago.style.display = 'block';
    contenedorPago.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  formulario.addEventListener('submit', function (evento) {
    evento.preventDefault();

    ultimoEmail = document.getElementById('email').value;
    const datos = {
      tipo: 'inscripcion',
      nombre: document.getElementById('nombre').value,
      telefono: document.getElementById('telefono').value,
      email: ultimoEmail
    };

    boton.disabled = true;
    boton.textContent = 'Enviando...';

    if (GOOGLE_SCRIPT_URL.indexOf('PEGAR_AQUI') !== -1) {
      // Todavía no se conectó la planilla. Igual dejamos pasar a la persona a la pantalla de pago,
      // pero avisamos en la consola para que quien administre el sitio lo note.
      console.warn('Falta conectar GOOGLE_SCRIPT_URL a la planilla de Google Sheets.');
      boton.disabled = false;
      boton.textContent = 'Enviar inscripción';
      irAPantallaPago();
      return;
    }

    fetch(GOOGLE_SCRIPT_URL, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(datos)
    })
      .catch(function () {
        // Aunque falle el envío a la planilla, la persona ya pagó su lugar en su cabeza,
        // así que la dejamos avanzar igual a la pantalla de pago.
      })
      .finally(function () {
        boton.disabled = false;
        boton.textContent = 'Enviar inscripción';
        irAPantallaPago();
      });
  });

  botonWhatsapp.addEventListener('click', function (evento) {
    evento.preventDefault();
    const destino = botonWhatsapp.getAttribute('href');

    if (GOOGLE_SCRIPT_URL.indexOf('PEGAR_AQUI') === -1) {
      fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo: 'pago', email: ultimoEmail })
      }).catch(function () {});
    }

    window.open(destino, '_blank');
  });
</script>

