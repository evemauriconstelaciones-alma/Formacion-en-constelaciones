<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Formación en Constelaciones</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --verde: #00e0a7;
    --violeta: #ba67f9;
    --texto: #241b33;
    --texto-suave: #5b5468;
    --fondo: #faf9fc;
    --tarjeta: #ffffff;
    --borde: #ece7f3;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    color: var(--texto);
    background: var(--fondo);
    line-height: 1.65;
    min-height: 100vh;
  }

  img { max-width: 100%; }

  h1, h2, h3 {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    line-height: 1.25;
  }

  .contenedor {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }

  a { color: inherit; }

  .pantalla { display: none; min-height: 100vh; flex-direction: column; }
  .pantalla.activa { display: flex; }

  header {
    padding: 20px 0;
  }

  header .contenedor {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .marca-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .marca-header img {
    width: 36px;
    height: auto;
  }

  .logo-texto {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.3px;
    background: linear-gradient(90deg, var(--verde), var(--violeta));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .volver {
    font-size: 14px;
    font-weight: 500;
    color: var(--texto-suave);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
  }

  .volver:hover { color: var(--violeta); }

  /* Pantalla inicio */
  #pantalla-inicio main {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 32px 0 64px;
    text-align: center;
    width: 100%;
    background: radial-gradient(circle at 15% 20%, rgba(0,224,167,0.16), transparent 45%),
                radial-gradient(circle at 85% 15%, rgba(186,103,249,0.18), transparent 45%);
  }

  .hero img.simbolo {
    width: clamp(160px, 32vw, 240px);
    height: auto;
    margin-bottom: 4px;
  }

  .etiqueta-logo {
    font-family: 'Poppins', sans-serif;
    font-style: italic;
    font-weight: 600;
    font-size: clamp(20px, 3.4vw, 26px);
    letter-spacing: 0.4px;
    color: var(--violeta);
    margin-bottom: 10px;
  }

  .marca-hero {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 3.6vw, 28px);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    background: linear-gradient(90deg, var(--verde), var(--violeta));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 26px;
  }

  .hero h1 {
    font-size: clamp(28px, 5.5vw, 46px);
    margin: 0 auto 20px;
    max-width: 700px;
  }

  .hero h1 span {
    background: linear-gradient(90deg, var(--verde), var(--violeta));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero p.bajada {
    max-width: 540px;
    margin: 0 auto 34px;
    font-size: 17px;
    color: var(--texto-suave);
  }

  .boton {
    display: inline-block;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #16112a;
    background: linear-gradient(90deg, var(--verde), var(--violeta));
    padding: 16px 38px;
    border-radius: 999px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    box-shadow: 0 12px 24px rgba(186,103,249,0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .boton:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 28px rgba(186,103,249,0.36);
  }

  /* Pantalla información */
  .hero-info {
    padding: 28px 0 44px;
    text-align: center;
    background: radial-gradient(circle at 15% 20%, rgba(0,224,167,0.14), transparent 45%),
                radial-gradient(circle at 85% 15%, rgba(186,103,249,0.16), transparent 45%);
  }

  .etiqueta {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--violeta);
    background: rgba(186,103,249,0.1);
    border: 1px solid rgba(186,103,249,0.25);
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 18px;
  }

  .hero-info h1 {
    font-size: clamp(26px, 5vw, 38px);
    max-width: 680px;
    margin: 0 auto 14px;
  }

  .hero-info h1 span {
    background: linear-gradient(90deg, var(--verde), var(--violeta));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-info p {
    max-width: 580px;
    margin: 0 auto;
    color: var(--texto-suave);
    font-size: 16px;
  }

  section {
    padding: 44px 0;
  }

  .titulo-seccion {
    text-align: center;
    font-size: clamp(22px, 4vw, 30px);
    margin-bottom: 14px;
  }

  .subtitulo-seccion {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 32px;
    color: var(--texto-suave);
    font-size: 16px;
  }

  .franja {
    color: var(--violeta);
  }

  .sobre p {
    max-width: 720px;
    margin: 0 auto 18px;
    font-size: 16.5px;
    color: var(--texto-suave);
  }

  .sobre p:last-child { margin-bottom: 0; }

  .incluye {
    background: var(--tarjeta);
  }

  .lista-incluye {
    max-width: 640px;
    margin: 0 auto;
    display: grid;
    gap: 14px;
  }

  .item-incluye {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: var(--fondo);
    border: 1px solid var(--borde);
    padding: 16px 18px;
    border-radius: 14px;
  }

  .marca {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--verde), var(--violeta));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    font-weight: 700;
  }

  .item-incluye p { font-size: 15.5px; color: var(--texto); }

  .facilitadora .tarjeta-facilitadora {
    max-width: 640px;
    margin: 0 auto;
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: 20px;
    padding: 36px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(36,27,51,0.06);
  }

  .inicial {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--verde), var(--violeta));
    color: white;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
  }

  .tarjeta-facilitadora h3 { font-size: 20px; margin-bottom: 6px; }

  .rol-facilitadora {
    color: var(--violeta);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 14px;
  }

  .tarjeta-facilitadora p.bio { color: var(--texto-suave); font-size: 15.5px; }

  .inversion {
    background: var(--tarjeta);
  }

  .tarjeta-precio {
    max-width: 640px;
    margin: 0 auto;
    border-radius: 22px;
    padding: 40px;
    text-align: center;
    background: linear-gradient(160deg, rgba(0,224,167,0.1), rgba(186,103,249,0.12));
    border: 1px solid var(--borde);
  }

  .precio-linea {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(21px, 4vw, 28px);
    margin-bottom: 8px;
  }

  .precio-viejo {
    text-decoration: line-through;
    color: var(--texto-suave);
    font-weight: 500;
    margin: 0 4px;
  }

  .precio-nuevo {
    background: linear-gradient(90deg, var(--verde), var(--violeta));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .precio-detalle { color: var(--texto-suave); font-size: 15px; margin-bottom: 20px; }

  .descuento-nota {
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: 14px;
    padding: 16px 20px;
    font-size: 14.5px;
    color: var(--texto);
    text-align: left;
  }

  .cta-info {
    text-align: center;
    margin-top: 44px;
  }

  /* Pantalla inscripción y pago */
  .hero-inscripcion {
    padding: 28px 0 8px;
    text-align: center;
  }

  .hero-inscripcion p {
    max-width: 560px;
    margin: 10px auto 0;
    color: var(--texto-suave);
    font-size: 16px;
  }

  .inscripcion-pago {
    background: linear-gradient(160deg, #1c1430, #2a1c3f);
    color: white;
    flex: 1;
  }

  .inscripcion-pago .titulo-seccion,
  .inscripcion-pago .hero-inscripcion h1 { color: white; }

  .inscripcion-pago .hero-inscripcion p { color: rgba(255,255,255,0.72); }

  .bloque-form-pago {
    max-width: 520px;
    margin: 0 auto;
  }

  .tarjeta-form, .tarjeta-pago {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
    padding: 32px;
    backdrop-filter: blur(6px);
  }

  .tarjeta-form h3, .tarjeta-pago h3 {
    font-size: 19px;
    margin-bottom: 20px;
    text-align: center;
  }

  .campo { margin-bottom: 16px; }

  .campo label {
    display: block;
    font-size: 13.5px;
    font-weight: 500;
    margin-bottom: 8px;
    color: rgba(255,255,255,0.85);
  }

  .campo input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.08);
    color: white;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    outline: none;
    transition: border 0.2s ease, background 0.2s ease;
  }

  .campo input::placeholder { color: rgba(255,255,255,0.4); }

  .campo input:focus {
    border-color: var(--verde);
    background: rgba(255,255,255,0.12);
  }

  .boton-enviar {
    width: 100%;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #16112a;
    background: linear-gradient(90deg, var(--verde), var(--violeta));
    padding: 16px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    margin-top: 4px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .boton-enviar:hover { transform: translateY(-2px); }
  .boton-enviar:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .mensaje-estado {
    margin-top: 14px;
    font-size: 14.5px;
    text-align: center;
    display: none;
  }

  .mensaje-estado.exito { color: var(--verde); display: block; }
  .mensaje-estado.error { color: #ff9d9d; display: block; }

  .tarjeta-pago .precio-viejo { color: rgba(255,255,255,0.55); }
  .tarjeta-pago .precio-detalle { color: rgba(255,255,255,0.65); }
  .tarjeta-pago .descuento-nota {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.14);
    color: rgba(255,255,255,0.85);
  }

  .boton-pago {
    display: inline-block;
    width: 100%;
    text-align: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #16112a;
    background: white;
    padding: 15px;
    border-radius: 12px;
    text-decoration: none;
    margin-top: 18px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .boton-pago:hover { transform: translateY(-2px); opacity: 0.92; }

  .bloque-whatsapp {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,0.14);
    text-align: center;
  }

  .bloque-whatsapp p {
    color: rgba(255,255,255,0.75);
    font-size: 14px;
    margin-bottom: 14px;
  }

  .boton-whatsapp {
    display: inline-block;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: white;
    background: #25d366;
    padding: 12px 26px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .boton-whatsapp:hover { transform: translateY(-2px); opacity: 0.92; }

  footer {
    padding: 26px 0;
    text-align: center;
    font-size: 13.5px;
    color: var(--texto-suave);
  }

  .inscripcion-pago footer { color: rgba(255,255,255,0.5); }

  @media (max-width: 600px) {
    section { padding: 34px 0; }
    .tarjeta-facilitadora, .tarjeta-precio, .tarjeta-form, .tarjeta-pago { padding: 26px 22px; }
  }
</style>
</head>
<body>

<div class="pantalla activa" id="pantalla-inicio">
  <main>
    <section class="hero">
      <div class="contenedor">
        <img class="simbolo" src="data:image/png;base64," alt="Formación en Constelaciones">
        <p class="etiqueta-logo">Descubriendo el alma</p>
        <p class="marca-hero">Formación en Constelaciones</p>
        <h1>Un espacio para escuchar lo que tu <span>historia familiar</span> todavía tiene para decirte</h1>
        <p class="bajada">Una formación con salida laboral, pensada para mirar de otra manera los vínculos, las lealtades y los lugares que ocupamos dentro de nuestra familia, integrando la teoría con la experiencia viva de las constelaciones.</p>
        <button type="button" class="boton" data-ir="pantalla-informacion">Quiero más información</button>
      </div>
    </section>
  </main>
  <footer>
    <div class="contenedor">Formación en Constelaciones · Facilita Eve Mauri</div>
  </footer>
</div>

<div class="pantalla" id="pantalla-informacion">
  <header>
    <div class="contenedor">
      <div class="marca-header">
        <img src="data:image/png;base64," alt="Formación en Constelaciones">
        <span class="logo-texto">Formación en Constelaciones</span>
      </div>
      <button type="button" class="volver" data-ir="pantalla-inicio">Volver al inicio</button>
    </div>
  </header>

  <section class="hero-info">
    <div class="contenedor">
      <span class="etiqueta">Primera etapa · comienza el 8 de octubre</span>
      <h1>Todo lo que necesitás saber sobre la <span>formación</span></h1>
      <p>Un recorrido teórico y práctico en constelaciones, pensado para transitarlo paso a paso durante ocho meses.</p>
    </div>
  </section>

  <section class="sobre">
    <div class="contenedor">
      <h2 class="titulo-seccion">Sobre la <span class="franja">formación</span></h2>
      <p>Esta formación combina teoría y práctica para adentrarte en la mirada sistémica y fenomenológica de las constelaciones, un enfoque que permite reconocer los órdenes, los vínculos y las lealtades invisibles que se transmiten de generación en generación dentro de un sistema familiar.</p>
      <p>A lo largo de esta primera etapa vas a integrar los fundamentos teóricos con la experiencia directa del trabajo constelar, en un proceso pensado tanto para quienes buscan comprender su propia historia como para quienes se preparan para acompañar a otros desde este enfoque.</p>
    </div>
  </section>

  <section class="incluye">
    <div class="contenedor">
      <h2 class="titulo-seccion">Cómo se <span class="franja">cursa</span></h2>
      <p class="subtitulo-seccion">La cursada combina encuentros en línea con instancias presenciales de práctica.</p>
      <div class="lista-incluye">
        <div class="item-incluye">
          <span class="marca">✓</span>
          <p>Encuentro teórico y práctico semanal en línea</p>
        </div>
        <div class="item-incluye">
          <span class="marca">✓</span>
          <p>Práctica presencial de constelaciones una vez al mes, en la Ciudad Autónoma de Buenos Aires (CABA) o en Villa Domínico, zona sur</p>
        </div>
        <div class="item-incluye">
          <span class="marca">✓</span>
          <p>Material teórico de estudio entre encuentro y encuentro</p>
        </div>
        <div class="item-incluye">
          <span class="marca">✓</span>
          <p>Primera etapa de una formación de ocho meses</p>
        </div>
        <div class="item-incluye">
          <span class="marca">✓</span>
          <p>Salida laboral una vez completado el recorrido</p>
        </div>
        <div class="item-incluye">
          <span class="marca">✓</span>
          <p>Certificación al finalizar la formación</p>
        </div>
      </div>
    </div>
  </section>

  <section class="facilitadora">
    <div class="contenedor">
      <h2 class="titulo-seccion">Facilita este <span class="franja">recorrido</span></h2>
      <div class="tarjeta-facilitadora">
        <div class="inicial">EM</div>
        <h3>Eve Mauri</h3>
        <p class="rol-facilitadora">Facilitadora de constelaciones</p>
        <p class="bio">Acompaña cada encuentro con una mirada sistémica, integrando la teoría con la práctica vivencial para que cada estudiante pueda apropiarse del método paso a paso.</p>
      </div>
    </div>
  </section>

  <section class="inversion">
    <div class="contenedor">
      <h2 class="titulo-seccion">Inversión</h2>
      <p class="subtitulo-seccion">La formación se abona en ocho cuotas. Pagando en término accedés a un descuento importante.</p>
      <div class="tarjeta-precio">
        <p class="precio-linea">8 cuotas de <span class="precio-viejo">$150.000</span> <span class="precio-nuevo">$90.000</span></p>
        <p class="precio-detalle">por cuota, pagando antes del día 7 de cada mes. Pesos argentinos.</p>
        <div class="descuento-nota">
          Son 8 cuotas de $150.000. Pagando cada cuota antes del día 7 de ese mes, esa cuota queda en $90.000 pesos argentinos. Pasada esa fecha, la cuota vuelve a valer $150.000.
        </div>
      </div>
      <div class="cta-info">
        <button type="button" class="boton" data-ir="pantalla-inscripcion">Quiero inscribirme</button>
      </div>
    </div>
  </section>

  <footer>
    <div class="contenedor">Formación en Constelaciones · Facilita Eve Mauri</div>
  </footer>
</div>

<div class="pantalla" id="pantalla-inscripcion">
  <header>
    <div class="contenedor">
      <div class="marca-header">
        <img src="data:image/png;base64," alt="Formación en Constelaciones">
        <span class="logo-texto">Formación en Constelaciones</span>
      </div>
      <button type="button" class="volver" data-ir="pantalla-inicio">Volver al inicio</button>
    </div>
  </header>

  <section class="inscripcion-pago">
    <div class="contenedor">
      <div class="hero-inscripcion">
        <h1>Reservá tu lugar</h1>
        <p>Completá tus datos y aboná tu cuota para confirmar la inscripción.</p>
      </div>

      <div style="height:28px"></div>

      <div class="bloque-form-pago">
        <div class="tarjeta-form" id="tarjeta-form-contenedor">
          <h3>Datos de inscripción</h3>
          <form id="formInscripcion">
            <div class="campo">
              <label for="nombre">Nombre y apellido</label>
              <input type="text" id="nombre" name="nombre" placeholder="Escribí tu nombre y apellido" required>
            </div>
            <div class="campo">
              <label for="telefono">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" placeholder="Ej. 11 2345 6789" required>
            </div>
            <div class="campo">
              <label for="email">Correo electrónico</label>
              <input type="email" id="email" name="email" placeholder="tu@correo.com" required>
            </div>
            <button type="submit" class="boton-enviar" id="botonEnviar">Enviar inscripción</button>
            <p class="mensaje-estado" id="mensajeEstado"></p>
          </form>
        </div>

        <div class="tarjeta-pago" id="tarjeta-pago-contenedor" style="display:none;">
          <h3>Aboná tu lugar</h3>
          <p class="precio-linea">8 cuotas de <span class="precio-viejo">$150.000</span> <span class="precio-nuevo">$90.000</span></p>
          <p class="precio-detalle">por cuota, pagando antes del día 7 de cada mes. Pesos argentinos.</p>
          <div class="descuento-nota">
